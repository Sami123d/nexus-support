# Primary LLM (required: set ONE of these)
# Gemini free tier — if set, it is used as the primary model (default gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
PRIMARY_MODEL=deepseek-chat

# Fallback LLM (optional but recommended) — used automatically if the primary
# call fails. Any OpenAI-compatible provider works; defaults to real OpenAI.
FALLBACK_API_KEY=your_fallback_provider_api_key_here
FALLBACK_MODEL=gpt-4o-mini
# FALLBACK_API_BASE=https://api.your-provider.com/v1

# FastAPI bearer token — required, no default. Generate a real secret, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`
API_KEY=your_own_random_secret_here

DATABASE_URL=customers.db
LOG_LEVEL=INFO
